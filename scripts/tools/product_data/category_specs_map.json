{
  "_description": "Mapping des champs de spécifications obligatoires (required) et optionnels (optional) par catégorie de produit. Utilisé par le workflow /generate-product-data et le script validate_product_data.py.",
  "_version": "1.0",

  "smartphone": {
    "template": "Template_ProductData_tech.json",
    "required": ["processor", "ram_options", "storage_options", "screen_size", "screen_technology", "battery_capacity", "os", "camera_main"],
    "optional": ["screen_refresh_rate", "charging_wired", "charging_wireless", "camera_ultrawide", "camera_telephoto", "camera_selfie", "video_max", "connectivity_5g", "connectivity_wifi", "connectivity_bluetooth", "connectivity_nfc", "sim_type", "water_resistance", "dimensions", "weight", "materials", "biometrics"],
    "price_range_fcfa": { "min": 30000, "max": 2500000 },
    "model_number_patterns": ["SM-[A-Z][0-9]{3}[A-Z]?", "RMX[0-9]{4}", "M[0-9]{4}", "CPH[0-9]{4}", "V[0-9]{4}", "[A-Z]{2,3}-[0-9]{3,5}"]
  },

  "tablet": {
    "template": "Template_ProductData_tech.json",
    "required": ["processor", "ram_options", "storage_options", "screen_size", "screen_technology", "battery_capacity", "os"],
    "optional": ["screen_refresh_rate", "charging_wired", "camera_main", "camera_selfie", "connectivity_wifi", "dimensions", "weight", "sim_type", "stylus_support"],
    "price_range_fcfa": { "min": 50000, "max": 1500000 },
    "model_number_patterns": ["SM-[A-Z][0-9]{3}[A-Z]?", "[A-Z]{2,5}-[0-9]{2,5}", "[0-9]{4,5}[A-Z]{2,}[0-9A-Z]*"]
  },

  "laptop": {
    "template": "Template_ProductData_tech.json",
    "required": ["processor", "ram_options", "storage_options", "screen_size", "screen_technology", "screen_resolution", "os", "battery_capacity"],
    "optional": ["gpu", "charging_wired", "keyboard_backlit", "connectivity_wifi", "connectivity_bluetooth", "ports", "dimensions", "weight", "webcam", "biometrics"],
    "price_range_fcfa": { "min": 150000, "max": 5000000 },
    "model_number_patterns": ["[A-Z0-9]{2,}-[A-Z0-9]+"]
  },

  "pc_desktop": {
    "template": "Template_ProductData_tech.json",
    "required": ["processor", "ram_options", "storage_options", "os"],
    "optional": ["gpu", "power_supply", "form_factor", "ports", "connectivity_wifi", "dimensions", "weight"],
    "price_range_fcfa": { "min": 150000, "max": 5000000 },
    "model_number_patterns": ["[A-Z0-9-]+"]
  },

  "audio": {
    "template": "Template_ProductData_tech.json",
    "required": ["battery_capacity", "connectivity_bluetooth"],
    "optional": ["driver_size", "frequency_response", "noise_cancellation", "water_resistance", "charging_wired", "charging_wireless", "weight", "microphone", "codec_support"],
    "price_range_fcfa": { "min": 2000, "max": 500000 },
    "model_number_patterns": ["[A-Z0-9-]+"]
  },

  "wearable": {
    "template": "Template_ProductData_tech.json",
    "required": ["screen_size", "battery_capacity", "os", "connectivity_bluetooth"],
    "optional": ["screen_technology", "water_resistance", "sensors", "gps", "nfc", "charging_wireless", "weight", "materials", "health_features"],
    "price_range_fcfa": { "min": 5000, "max": 800000 },
    "model_number_patterns": ["SM-[A-Z][0-9]{3}[A-Z]?", "[A-Z0-9-]+"]
  },

  "storage": {
    "template": "Template_ProductData_tech.json",
    "required": ["storage_options"],
    "optional": ["interface", "read_speed", "write_speed", "form_factor", "encryption", "dimensions", "weight", "warranty"],
    "price_range_fcfa": { "min": 2000, "max": 300000 },
    "model_number_patterns": ["SDSD[A-Z0-9-]+", "[A-Z0-9-]+"]
  },

  "printer": {
    "template": "Template_ProductData_tech.json",
    "required": ["print_technology", "print_speed", "print_resolution"],
    "optional": ["scanner", "copier", "fax", "duplex", "connectivity_wifi", "paper_sizes", "tray_capacity", "dimensions", "weight", "monthly_duty_cycle"],
